{#def source_id, files, page=1, page_size=50, has_more=False #}
{% for file in files %}
    <pages.sources.FileRow file={{ file }} source_id={{ source_id }} />
{% else %}
    {% if page == 1 %}
        <tr>
            <td colspan="3" class="source-files-empty">
                No files yet.
            </td>
        </tr>
    {% endif %}
{% endfor %}
{% if has_more %}
    <tr class="source-files-loader"
        hx-get="/sources/{{ source_id }}/files?page={{ page + 1 }}&amp;page_size={{ page_size }}"
        hx-trigger="revealed"
        hx-swap="outerHTML">
        <td colspan="3">
            Loading more files…
        </td>
    </tr>
{% endif %}
