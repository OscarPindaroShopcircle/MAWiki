{#def sources, origin=None, current_user=None #}
{#css common/Dialog.css, common/Alert.css, common/Field.css, pages/sources/CreateDialog.css, pages/sources/SourceList.css, common/Avatar.css, common/Button.css, common/Card.css, common/Menu.css, common/Tooltip.css, layout/Page.css, layout/Sidebar.css, layout/UserMenu.css #}
<layout.Page title="Data Sources" current_user={{ current_user }} active="sources">
<div class="source-page">
    <header class="source-header">
        <div>
            <h1>
                Data Sources
            </h1>
            <a href="/sources?origin=USER">User-created</a> · <a href="/sources?origin=SYSTEM">System-generated</a>
        </div>
        {% if not origin or origin == "USER" %}
            <common.Button variant="primary" size="md" hx-get="/sources/new" hx-target="#source-create-dialog" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful) { document.querySelector('#source-create-dialog dialog').showModal(); }"><common.Icon name="plus" size=16 />New Data Source</common.Button>
        {% endif %}
    </header>
    <div id="source-grid">
        <pages.sources.SourceGrid sources={{ sources }} />
    </div>
    <div id="source-create-dialog">
    </div>
</div>
</layout.Page>
