{#def source_id, files, has_more=False #}
<div id="source-files-table"
     hx-get="/sources/{{ source_id }}/files"
     hx-trigger="source-files-refresh from:body"
     hx-target="find tbody"
     hx-swap="innerHTML"
     hx-on::after-request="if(event.detail.successful) lucide.createIcons();">
    <common.Table headers={{ ["Name", "Uploaded", ""] }}><pages.sources.FileRows source_id={{ source_id }} files={{ files }} page={{ 1 }} page_size={{ 50 }} has_more={{ has_more }} /></common.Table>
</div>
