{#def invitations #}
<common.Table headers={{ ["Email", "Role", "Invited By", "Expires", "Status", ""] }}>
  {% for inv in invitations %}
  <tr>
    <td>{{ inv.email }}</td>
    <td>
      {% if inv.role == 'admin' %}
      <common.Pill variant="role-admin">Admin</common.Pill>
      {% else %}
      <common.Pill variant="role-member">Member</common.Pill>
      {% endif %}
    </td>
    <td>{{ inv.invited_by_name or inv.invited_by }}</td>
    <td><em>{{ inv.expires_at | time }}</em></td>
    <td>
      {% if inv.accepted_at %}
      <common.Pill variant="success">Accepted</common.Pill>
      {% elif inv.is_expired %}
      <common.Pill variant="danger">Expired</common.Pill>
      {% else %}
      <common.Pill variant="warning">Pending</common.Pill>
      {% endif %}
    </td>
    <td>
      {% if not inv.accepted_at %}
      <common.Button variant="danger" size="sm"
        :hx-get="'/admin/users/invitations/' + inv.id|string + '/revoke'"
        hx-target="#confirm-dialog"
        hx-swap="innerHTML"
        :hx-on::after-request="'if(event.detail.successful){document.querySelector(\'#confirm-dialog dialog\').showModal(); lucide.createIcons();}'">
        <common.Icon name="trash-2" size=16 />
        Revoke
      </common.Button>
      {% endif %}
    </td>
  </tr>
  {% endfor %}
</common.Table>
