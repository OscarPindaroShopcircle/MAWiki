{#def error=None, mode="login", google_enabled=False, dev_login_email="" #}
<layout.BlankPage title="Sign in">
<div class="login-page">
    <common.Card variant="elevated" max_width={{ 400 }}>
    <div class="login-brand">
        <span class="login-brand-mark">C</span>
        <span class="login-brand-name">Circeus</span>
    </div>
    {% if error %}
        <common.Alert variant="danger">{{ error }}</common.Alert>
    {% endif %}
    {% if mode == "register" %}
        <form class="login-form"
              hx-post="/auth/register-form"
              hx-target="body"
              hx-swap="outerHTML">
            <h1 class="login-title">
                Create your account
            </h1>
            <p class="login-subtitle">
                Enter your details to sign up.
            </p>
            <common.Field label="Name" name="name" type="text" placeholder="Jane Doe" required autocomplete="name" />
            <common.Field label="Email" name="email" type="email" placeholder="jane@example.com" required autocomplete="email" />
            <common.Field label="Password" name="password" type="password" placeholder="At least 8 characters" required minlength=8 autocomplete="new-password" />
            <common.Button type="submit" variant="primary" size="md" block>Create account</common.Button>
        </form>
        <p class="login-switch">
            Already have an account? <a href="/login">Sign in</a>
        </p>
    {% else %}
        <form class="login-form"
              hx-post="/auth/login-form"
              hx-target="body"
              hx-swap="outerHTML">
            <h1 class="login-title">
                Sign in
            </h1>
            <p class="login-subtitle">
                Enter your email and password.
            </p>
            <common.Field label="Email" name="email" type="email" placeholder="jane@example.com" required autocomplete="email" />
            <common.Field label="Password" name="password" type="password" placeholder="Your password" required autocomplete="current-password" />
            <common.Button type="submit" variant="primary" size="md" block>Sign in</common.Button>
        </form>
        <p class="login-switch">
            No account? <a href="/login?mode=register">Register</a>
        </p>
    {% endif %}
    {% if google_enabled %}
        <common.Divider label="or" />
        <common.Button variant="secondary" size="md" href="/auth/google" block>
        <svg width="18"
             height="18"
             viewBox="0 0 24 24"
             fill="none"
             xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z" fill="#EA4335" />
        </svg>
        Continue with Google
        </common.Button>
    {% else %}
        <common.Divider label="dev" />
        <form class="login-form"
              hx-post="/auth/dev-login-form"
              hx-target="body"
              hx-swap="outerHTML">
            <p class="login-subtitle">
                Dev mode — enter your email to sign in without a password.
            </p>
            <common.Field label="Email" name="email" type="email" required autocomplete="email" :value="dev_login_email" />
            <common.Button type="submit" variant="secondary" size="md" block>Dev sign in</common.Button>
        </form>
    {% endif %}
    </common.Card>
</div>
</layout.BlankPage>
