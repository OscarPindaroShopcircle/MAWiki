{#def file, knowledge_base_id #}
<tr>
  <td>
    <div class="kb-file-name">
      <pages.kb.FileIcon :name="file.name" :mime_type="file.mime_type" />
      <span class="kb-file-label">{{ file.name }}</span>
    </div>
  </td>
  <td>{{ file.created_at | time }}</td>
  <td class="kb-file-actions">
    <common.Tooltip text="Download">
      <common.Button variant="secondary" size="sm" icon=True
        :href="'/api/knowledge-bases/' + knowledge_base_id|string + '/files/' + file.id|string + '/download'"
        :aria-label="'Download ' + file.name" download>
        <common.Icon name="download" size=16 />
      </common.Button>
    </common.Tooltip>
  </td>
</tr>
