{#def knowledge_base_id, files, page=1, page_size=50, has_more=False #}
{% for file in files %}
<pages.kb.FileRow file={{ file }} knowledge_base_id={{ knowledge_base_id }} />
{% else %}
  {% if page == 1 %}
  <tr><td colspan="3" class="kb-files-empty">No files yet. Upload some to get started.</td></tr>
  {% endif %}
{% endfor %}
{% if has_more %}
<tr class="kb-files-loader"
    hx-get="/knowledge-bases/{{ knowledge_base_id }}/files?page={{ page + 1 }}&amp;page_size={{ page_size }}"
    hx-trigger="revealed" hx-swap="outerHTML">
  <td colspan="3">Loading more files…</td>
</tr>
{% endif %}
