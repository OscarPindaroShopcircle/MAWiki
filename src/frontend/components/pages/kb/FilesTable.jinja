{#def knowledge_base_id, files, has_more=False #}
<div id="kb-files-table"
     hx-get="/knowledge-bases/{{ knowledge_base_id }}/files"
     hx-trigger="kb-files-refresh from:body"
     hx-target="find tbody" hx-swap="innerHTML"
     hx-on::after-request="if(event.detail.successful) lucide.createIcons();">
  <common.Table headers={{ ["Name", "Uploaded", ""] }}>
    <pages.kb.FileRows knowledge_base_id={{ knowledge_base_id }} files={{ files }}
                       page={{ 1 }} page_size={{ 50 }} has_more={{ has_more }} />
  </common.Table>
</div>
