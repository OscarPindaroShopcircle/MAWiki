{#def knowledge_bases #}
<div class="kb-grid">
  {% for kb in knowledge_bases %}
  <a href="/knowledge-bases/{{ kb.id }}" class="kb-card-link">
    <common.Card variant="outlined" class="kb-card">
      <h3 class="kb-card-title">{{ kb.name }}</h3>
      <p class="kb-card-date">Created at: {{ kb.created_at.strftime("%d/%m/%Y") }}</p>
      <div class="kb-card-footer">
        {% if kb.shared_with %}
        <common.AvatarStack users={{ kb.shared_with }} />
        {% else %}
        <span></span>
        {% endif %}
        <p class="kb-card-owner">Owner: <strong>{{ kb.created_by.name }}</strong></p>
      </div>
    </common.Card>
  </a>
  {% else %}
  <p class="kb-empty">No knowledge bases yet. Create one to get started.</p>
  {% endfor %}
</div>
