{#def knowledge_bases, current_user=None #}
{#css common/Dialog.css, common/Alert.css, common/Field.css, pages/kb/CreateDialog.css #}
<layout.Page title="Knowledge Bases" current_user={{ current_user }} active="knowledge-bases">
  <div class="kb-page">
    <header class="kb-header">
      <h1>Knowledge Bases</h1>
      <common.Button variant="primary" size="md"
        hx-get="/knowledge-bases/new"
        hx-target="#kb-create-dialog"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) { document.querySelector('#kb-create-dialog dialog').showModal(); lucide.createIcons(); }">
        <common.Icon name="plus" size=16 />
        New Knowledge Base
      </common.Button>
    </header>

    <div id="kb-grid">
      <pages.kb.KnowledgeBaseGrid knowledge_bases={{ knowledge_bases }} />
    </div>

    <div id="kb-create-dialog"></div>
  </div>
</layout.Page>
