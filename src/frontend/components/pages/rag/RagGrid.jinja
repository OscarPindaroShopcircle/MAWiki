{#def rag_models #}
<div class="kb-grid">
  {% for rag in rag_models %}
  <a href="/rag/{{ rag.id }}" class="kb-card-link">
    <common.Card variant="outlined" class="kb-card">
      <div class="kb-card-icon"><common.Icon name="blocks" size=24 /></div>
      <h3 class="kb-card-title">{{ rag.name }}</h3>
      <p class="kb-card-meta">Knowledge base: {{ rag.source_knowledge_base.name }}</p>
      <div>
        <common.Pill :variant="'success' if rag.index_file_id else 'neutral'">
          {{ "Indexed" if rag.index_file_id else "Not indexed" }}
        </common.Pill>
      </div>
    </common.Card>
  </a>
  {% else %}
  <p class="kb-empty">No RAG models yet. Create one to get started.</p>
  {% endfor %}
</div>
