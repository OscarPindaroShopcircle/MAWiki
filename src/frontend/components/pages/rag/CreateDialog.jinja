{#def knowledge_bases, error=None, name="", source_knowledge_base_id="" #}
<common.Dialog title="New RAG model">
  <form class="kb-create-form"
        hx-post="/rag"
        hx-target="#rag-grid"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) this.closest('dialog').close()">
    {% if error %}
    <common.Alert variant="danger">{{ error }}</common.Alert>
    {% endif %}
    {% if knowledge_bases %}
    <common.Field label="Name" name="name" placeholder="Engineering Search" required :value="name" />
    <common.Field label="Knowledge Base" name="sourceKnowledgeBaseId" required
                  :options="knowledge_bases" :value="source_knowledge_base_id" />
    {% else %}
    <common.Alert variant="info">Create a knowledge base before creating a RAG model.</common.Alert>
    {% endif %}
    <div class="kb-create-actions">
      <common.Button type="button" variant="secondary" size="md"
                     onclick="this.closest('dialog').close()">Cancel</common.Button>
      {% if knowledge_bases %}
      <common.Button type="submit" variant="primary" size="md">Create</common.Button>
      {% endif %}
    </div>
  </form>
</common.Dialog>
