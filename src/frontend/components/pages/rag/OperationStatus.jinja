{#def rag_id, operation, task=None, ready=False #}
{% set status = task.status.value if task and task.status.value is defined else task.status if task else none %}
{% set variant = "success" if status == "SUCCESS" else "danger" if status == "FAILED" else "info" if status in ["WAITING", "IN_PROGRESS"] else "success" if ready else "neutral" %}
<div id="rag-{{ operation }}-status"
  {% if status in ["WAITING", "IN_PROGRESS"] %}
  hx-get="/rag/{{ rag_id }}/{{ operation }}/status"
  hx-trigger="load delay:1s"
  hx-swap="outerHTML"
  {% endif %}>
  <common.Pill :variant="variant">
    {% if status %}{{ status|lower|replace("_", " ") }}{% elif ready %}ready{% else %}not started{% endif %}
  </common.Pill>
  {% if task and task.message %}<p class="rag-operation-message">{{ task.message }}</p>{% endif %}
</div>
