{#def chunks #}
<div class="rag-chunk-list">
  {% for chunk in chunks %}
  <article class="rag-chunk">
    <div class="rag-chunk-meta">
      <strong>Chunk {{ loop.index }}</strong>
      <span>Output {{ chunk.output_index + 1 }}</span>
      {% if chunk.page_number %}<span>Page {{ chunk.page_number }}</span>{% endif %}
      <span>Offset {{ chunk.split_idx_start }}</span>
      <span>{{ chunk.word_count }} words</span>
      <span>{{ chunk.character_count }} characters</span>
    </div>
    <p>{{ chunk.preview }}</p>
  </article>
  {% else %}
  <p>No indexed chunks were found for this file.</p>
  {% endfor %}
</div>
