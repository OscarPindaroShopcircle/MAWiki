{#def rag, file, chunks=[], current_user=None #}
{#css pages/kb/KnowledgeBaseDetail.css, pages/rag/RagDetail.css #}
<layout.Page :title="file.name" current_user={{ current_user }} active="rag">
  <div class="kb-detail rag-detail">
    <header class="kb-detail-header">
      <div>
        <a href="/rag/{{ rag.id }}" class="kb-detail-back">
          <common.Icon name="arrow-left" size=16 />
          {{ rag.name }}
        </a>
        <h1>{{ file.name }}</h1>
        <p class="rag-source">{{ file.mime_type or "Unknown file type" }}</p>
      </div>
      <common.Pill :variant="'success' if file.is_converted else 'neutral'">
        {{ "Converted" if file.is_converted else "Not converted" }}
      </common.Pill>
    </header>

    <common.Card variant="outlined" class="rag-pipeline-panel">
      <section>
        <div class="rag-operation-heading">
          <common.Icon name="file-text" size=22 />
          <h2>Converted documents</h2>
        </div>
        {% if file.converted_files %}
        <div class="rag-output-list">
          {% for output in file.converted_files %}
          <article class="rag-document" data-rag-document>
            <header class="rag-document-header">
              <div>
                <h3>{{ output.name }}</h3>
                <span>Output {{ output.output_index + 1 }}</span>
              </div>
              <div class="rag-view-toggle" role="group" aria-label="Document view">
                <button type="button" data-rag-mode="rendered" aria-pressed="true">Rendered</button>
                <button type="button" data-rag-mode="source" aria-pressed="false">Source</button>
              </div>
            </header>
            <div class="rag-document-content rag-document-rendered" data-rag-rendered>{{ output.content | markdown }}</div>
            <pre class="rag-document-content rag-document-source" data-rag-source hidden>{{ output.content }}</pre>
            <div hidden>
              {% for chunk in chunks %}
              {% if chunk.output_index == output.output_index %}
              <span data-rag-chunk data-start="{{ chunk.split_idx_start }}" data-end="{{ chunk.split_idx_end }}"
                data-color="{{ chunk.color_index }}" data-label="Chunk {{ loop.index }}"></span>
              {% endif %}
              {% endfor %}
            </div>
          </article>
          {% endfor %}
        </div>
        {% else %}
        <p class="rag-operation-message">This file has no converted output.</p>
        {% endif %}
      </section>

      <common.Divider />

      <details class="rag-files-section" open>
        <summary>
          <span><common.Icon name="layers-3" size=20 /> Chunk map</span>
          <common.Icon name="chevron-down" size=18 />
        </summary>
        <div class="rag-files-content">
          {% if chunks %}
          <pages.rag.ChunkList chunks={{ chunks }} />
          {% elif rag.is_indexed and file.is_converted %}
          <p>No indexed chunks were found for this file.</p>
          {% else %}
          <p>Index this RAG model to color the document by chunk.</p>
          {% endif %}
        </div>
      </details>
    </common.Card>
  </div>
</layout.Page>
