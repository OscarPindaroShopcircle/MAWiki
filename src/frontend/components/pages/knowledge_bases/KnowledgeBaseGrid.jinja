{#def knowledge_bases #}
<div class="kb-grid">
    {% for knowledge_base in knowledge_bases %}
        <a href="/knowledge-bases/{{ knowledge_base.id }}" class="kb-card-link"><common.Card variant="outlined" class="kb-card">
            <div class="kb-card-icon">
                <common.Icon name="blocks" size=24 />
            </div>
            <h3 class="kb-card-title">
                {{ knowledge_base.name }}
            </h3>
            <p class="kb-card-meta">
                Source: {{ knowledge_base.source_name }}
            </p>
            <div>
                <common.Pill :variant="'success' if knowledge_base.is_indexed else 'neutral'">{{ "Indexed" if knowledge_base.is_indexed else "Not indexed" }}</common.Pill>
            </div>
        </common.Card></a>
    {% else %}
        <p class="kb-empty">
            No knowledge bases yet. Create one to get started.
        </p>
    {% endfor %}
</div>
