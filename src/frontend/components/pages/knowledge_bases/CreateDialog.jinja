{#def sources, error=None, name="", source_id="" #}
<common.Dialog title="New knowledge base">
<form class="kb-create-form"
      hx-post="/knowledge-bases"
      hx-target="#knowledge-base-grid"
      hx-swap="innerHTML"
      hx-on::after-request="if(event.detail.successful) this.closest('dialog').close()">
    {% if error %}
        <common.Alert variant="danger">{{ error }}</common.Alert>
    {% endif %}
    {% if sources %}
        <common.Field label="Name" name="name" placeholder="Engineering Search" required :value="name" /><common.Field label="Data Source" name="sourceId" required :options="sources" :value="source_id" />
    {% else %}
        <common.Alert variant="info">Create a data source before creating a knowledge base.</common.Alert>
    {% endif %}
    <div class="kb-create-actions">
        <common.Button type="button" variant="secondary" size="md" onclick="this.closest('dialog').close()">Cancel</common.Button>
        {% if sources %}
            <common.Button type="submit" variant="primary" size="md">Create</common.Button>
        {% endif %}
    </div>
</form>
</common.Dialog>
