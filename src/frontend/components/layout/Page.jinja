  {#def title, current_user=None, active=None, is_dev=False #}
{# Pass values through with `:prop="expr"`. A quoted "{{ title }}" is handed to
   the child component as that literal string, not as the variable's value. #}
<layout.BlankPage :title="title">
  <layout.Sidebar :current_user="current_user" :active="active" :is_dev="is_dev" />
  <main class="page-main">
    {{ content }}
  </main>
</layout.BlankPage>
