  {#def current_user=None, active=None, badges=None #}
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <span class="sidebar-brand-name">Circeus</span>
    <common.Tooltip text="Toggle sidebar" position="bottom">
      <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">
        <common.Icon name="panel-left-close" size=18 />
      </button>
    </common.Tooltip>
  </div>
  <nav class="sidebar-nav">
    <layout.SidebarSection>
      <layout.SidebarItem href="/" icon="home" label="Home" :active="active" match="home" />
      <layout.SidebarItem href="/knowledge-bases" icon="database" label="Knowledge Bases"
                          :active="active" match="knowledge-bases" />
    </layout.SidebarSection>

    {% if current_user is admin %}
    <layout.SidebarSection label="Admin">
      {% if badges and badges.get('admin') %}
      <layout.SidebarItem href="/admin/users" icon="users" label="Users"
                          :active="active" match="admin-users"
                          :badge="badges['admin']" />
      {% else %}
      <layout.SidebarItem href="/admin/users" icon="users" label="Users"
                          :active="active" match="admin-users" />
      {% endif %}

      {% if env is dev %}
      <layout.SidebarItem href="/components" icon="palette" label="Showcase"
                          :active="active" match="showcase" />
      {% endif %}
    </layout.SidebarSection>
    {% endif %}
  </nav>
  <div class="sidebar-footer">
    {% if current_user %}
    <layout.UserMenu current_user={{ current_user }} />
    {% endif %}
  </div>
</aside>
<script>
  // Keyboard navigation — Arrow keys, Home, End navigate between sidebar links
  (function () {
    document.addEventListener("keydown", function (e) {
      var sidebar = document.getElementById("sidebar");
      if (!sidebar || !sidebar.contains(document.activeElement)) return;
      var links = Array.from(sidebar.querySelectorAll(".sidebar-link"));
      if (!links.length) return;
      var index = links.indexOf(document.activeElement);
      if (index === -1) return;
      var next = null;
      if (e.key === "ArrowDown") next = (index + 1) % links.length;
      if (e.key === "ArrowUp") next = (index - 1 + links.length) % links.length;
      if (e.key === "Home") next = 0;
      if (e.key === "End") next = links.length - 1;
      if (next !== null) {
        links[next].focus();
        e.preventDefault();
      }
    });
  })();
</script>
