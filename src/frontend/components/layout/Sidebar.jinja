  {#def current_user=None, active=None, badges=None #}
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <span class="sidebar-brand-name">Circeus</span>
    <common.Tooltip text="Toggle sidebar" position="bottom">
      <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">
        <common.Icon name="panel-left-close" size=18 />
      </button>
    </common.Tooltip>
  </div>
  <nav class="sidebar-nav">
    <a href="/" class="sidebar-link {{ 'sidebar-link-active' if active == 'home' else '' }}">
      <span class="sidebar-link-icon">
        <common.Icon name="home" size=20 />
      </span>
      <span class="sidebar-link-label">Home</span>
    </a>

    <a href="/knowledge-bases" class="sidebar-link {{ 'sidebar-link-active' if active == 'knowledge-bases' else '' }}">
      <span class="sidebar-link-icon">
        <common.Icon name="database" size=20 />
      </span>
      <span class="sidebar-link-label">Knowledge Bases</span>
    </a>

    {% if current_user is admin %}
    <span class="sidebar-section-label">Admin</span>
    <a href="/admin/users" class="sidebar-link {{ 'sidebar-link-active' if active == 'admin-users' else '' }}">
      <span class="sidebar-link-icon">
        <common.Icon name="users" size=20 />
      </span>
      <span class="sidebar-link-label">Users</span>
      {% if badges and badges.get('admin') %}
      <span class="sidebar-link-badge">{{ badges['admin'] }}</span>
      {% endif %}
    </a>
    {% if is_dev %}
    <a href="/components" class="sidebar-link {{ 'sidebar-link-active' if active == 'showcase' else '' }}">
      <span class="sidebar-link-icon">
        <common.Icon name="palette" size=20 />
      </span>
      <span class="sidebar-link-label">Showcase</span>
    </a>
    {% endif %}
    {% endif %}
  </nav>
  <div class="sidebar-footer">
    {% if current_user %}
    <layout.UserMenu current_user={{ current_user }} />
    {% endif %}
  </div>
</aside>
